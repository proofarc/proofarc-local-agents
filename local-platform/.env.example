# Settings for ProofArc on this machine. ./start.sh copies this file to .env and fills in every
# password and key left empty, so the only line you must fill in is the pull token.

# The pull token we sent you, for downloading our images from ghcr.io.
PROOFARC_PULL_TOKEN=

# The ProofArc version. Leave as is unless we tell you otherwise.
PROOFARC_VERSION=v4.8.45

# Ports on this machine. Change one if ./start.sh says it is taken.
PROOFARC_UI_PORT=3000
PROOFARC_API_PORT=8080
PROOFARC_MCP_PORT=8090

# Two browser jobs at once need about 3 GB. On a small machine set PROOFARC_MAX_JOBS=1.
PROOFARC_MAX_JOBS=2
PROOFARC_BROWSER_MEMORY=3g

# Filled in by ./start.sh on the first start. Do not change ENCRYPTION_KEY afterwards: the saved
# logins of your apps are encrypted with it and could no longer be read.
# PROOFARC_ADMIN_PASSWORD is your password for the web app (user: admin).
PROOFARC_ADMIN_PASSWORD=
PROOFARC_AGENT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
