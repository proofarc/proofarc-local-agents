# Pull token for downloading our images from ghcr.io
PROOFARC_PULL_TOKEN=

# The Proofarc platform these agents work for. No trailing slash.
PROOFARC_URL=https://ui-outpostqa.proofarc.ai

# The token we give you. It is time-limited; when it expires the agents say
# AGENT_TOKEN_REJECTED in their logs and we send you a new one.
PROOFARC_AGENT_TOKEN=

# Only if we gave you an agent username and password instead of a token.
PROOFARC_AGENT_USERNAME=
PROOFARC_AGENT_PASSWORD=

# A short name for this site; it prefixes the agent names shown in the platform.
PROOFARC_SITE=outpostqa

# The platform version these agents match. Leave as is unless we tell you otherwise.
PROOFARC_VERSION=v4.8.26
